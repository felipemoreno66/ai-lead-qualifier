# Private instance (workspace david-moreno). Copy to .env.private (gitignored) and fill in.
# Used only with: docker compose --env-file .env.private -f docker-compose.yml -f docker-compose.private.yml up
# Never commit .env.private. Comments stay on their own lines. Values containing "$" go in single quotes.

# Database (its own volume; pick a real password)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Secrets, each 16+ characters (`openssl rand -hex 24`)
ADMIN_API_TOKEN=
N8N_API_TOKEN=
N8N_WEBHOOK_SECRET=
IP_HASH_SECRET=

# Dashboard login: a single operator.
# ADMIN_PASSWORD_HASH is an argon2id hash, never the password: run `pnpm hash-password` and paste
# its output line here, keeping the single quotes.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# BETTER_AUTH_SECRET: 32+ random characters (`openssl rand -hex 32`); signs the session cookie.
# Repeated characters and placeholders are refused.
BETTER_AUTH_SECRET=
# BETTER_AUTH_URL: the HTTPS address you open the dashboard on; the session cookie is Secure and
# browsers drop it over plain http. On a tailnet: `tailscale serve --bg --https=8443 3001` (never funnel),
# then https://<machine>.<tailnet>.ts.net:8443 (see the README, "Private instance").
BETTER_AUTH_URL=
# ADMIN_SESSION_HOURS: how long a sign-in lasts (default 12).
ADMIN_SESSION_HOURS=
# TRUST_FORWARDED_HOST: true only behind a reverse proxy you control.
TRUST_FORWARDED_HOST=
TRUSTED_PROXIES=

# URLs (public origin of the dashboard; the public form lives on the services page)
WEB_PUBLIC_ORIGIN=
DASHBOARD_BASE_URL=
PUBLIC_API_BASE_URL=

# Real email through Resend (default for this instance). Suggested: EMAIL_PROVIDER=resend
EMAIL_PROVIDER=
# EMAIL_FROM: a sender on a domain verified in Resend, for example "David Moreno <hello@mail.example.com>"
EMAIL_FROM=
RESEND_API_KEY=

# Real LLM provider (the fake one never qualifies real leads usefully). Suggested: LLM_PROVIDER=anthropic
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_BUDGET_USD=

# Host directory with the REAL workspace config (outside git); mounted read-only into the agent.
# Default ./data/private/workspaces (gitignored). Create it with: scripts/private-workspace.sh init
PRIVATE_WORKSPACES_DIR=

# Host ports (defaults keep this stack beside the public demo)
PRIVATE_WEB_PORT=
PRIVATE_AGENT_PORT=
PRIVATE_POSTGRES_PORT=

# Orchestration: inline only on this instance (suggested: ORCHESTRATOR=inline). n8n depends on Mailpit,
# which this override leaves out, and Resend works with the inline orchestrator only.
ORCHESTRATOR=

# ALLOW_DRAFT_WORKSPACES: true only to test the form locally while the workspace is still a draft.
ALLOW_DRAFT_WORKSPACES=
