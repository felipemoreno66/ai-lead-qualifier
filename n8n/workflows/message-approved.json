        "jsCode": "const crypto = require('crypto');\nconst secret = $env.N8N_WEBHOOK_SECRET;\nif (!secret) throw new Error('N8N_WEBHOOK_SECRET is not set');\nconst id = $('Verify signature').first().json.message.id;\nconst messageId = $input.first().json.messageId || null;\nconst body = JSON.stringify({ message_id: id, provider_message_id: messageId });\nconst path = `/internal/messages/${id}/sent`;\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(timestamp + '.POST ' + path + '.' + body).digest('hex');\nreturn [{ json: { url: `${$env.AGENT_INTERNAL_URL}${path}`, body, timestamp, signature } }];"
