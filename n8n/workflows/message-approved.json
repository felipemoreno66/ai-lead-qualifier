    {
      "id": "c1d3b2e1-0002-4000-8000-000000000102",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const crypto = require('crypto');\nconst MAX_AGE_SECONDS = 300;\nconst secret = $env.N8N_WEBHOOK_SECRET;\nif (!secret) throw new Error('N8N_WEBHOOK_SECRET is not set');\nconst item = $input.first();\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst timestamp = String(item.json.headers['x-timestamp'] || '');\nconst received = String(item.json.headers['x-signature'] || '');\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(timestamp + '.POST /webhook/message-approved.').update(raw).digest('hex');\nconst a = Buffer.from(expected);\nconst b = Buffer.from(received);\nconst fresh = /^\\d+$/.test(timestamp) && Math.abs(Date.now() / 1000 - Number(timestamp)) <= MAX_AGE_SECONDS;\nconst valid = fresh && a.length === b.length && crypto.timingSafeEqual(a, b);\nif (!valid) return [{ json: { valid: false } }];\nreturn [{ json: { valid: true, ...JSON.parse(raw.toString('utf8')) } }];"
      }
