# Copy to .env and edit. Every value is optional for a local `docker compose up`:
# Compose ships clearly marked development defaults for any variable left empty.
# Comments must stay on their own lines: an inline "# ..." after "=" would become part of the value.
# Never commit a real .env.

# General
# APP_ENV: local, test or production. Production requires every secret below (16+ characters,
# not the development defaults) and dashboard credentials.
APP_ENV=
LOG_LEVEL=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Workspaces
# ENABLED_WORKSPACES: comma-separated slugs, default northwind-academy.
ENABLED_WORKSPACES=
# ALLOW_DRAFT_WORKSPACES: true only for local experiments with draft workspaces.
ALLOW_DRAFT_WORKSPACES=

# URLs
# WEB_PUBLIC_ORIGIN: origin(s) of the web app, comma-separated, always allowed by CORS.
WEB_PUBLIC_ORIGIN=
# DASHBOARD_BASE_URL: used in owner notification links.
DASHBOARD_BASE_URL=
# PUBLIC_API_BASE_URL: agent URL as seen from the browser (default http://localhost:8000).
PUBLIC_API_BASE_URL=

# Secrets (generate each with `openssl rand -hex 24`)
# ADMIN_API_TOKEN: Next.js server to agent /admin.
ADMIN_API_TOKEN=
# N8N_API_TOKEN: n8n to agent /internal.
N8N_API_TOKEN=
# N8N_WEBHOOK_SECRET: HMAC key of the signed webhook to n8n.
N8N_WEBHOOK_SECRET=
# IP_HASH_SECRET: HMAC key used to store client IPs and emails as hashes.
IP_HASH_SECRET=

# Dashboard access (required when APP_ENV=production; HTTP Basic auth)
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Exposure
# EXPOSE_ADMIN_API: set to false to stop mounting /admin and /internal on this instance.
EXPOSE_ADMIN_API=
# TRUSTED_PROXIES: comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
TRUSTED_PROXIES=

# Orchestration
# ORCHESTRATOR: inline (default, no n8n needed) or n8n.
ORCHESTRATOR=
# COMPOSE_PROFILES: set to n8n to start the n8n service.
COMPOSE_PROFILES=

# Anti-abuse (defaults: 5 per minute, 30 per hour, 300 per hour, 3 per day)
RATE_IP_PER_MINUTE=
RATE_IP_PER_HOUR=
RATE_WORKSPACE_PER_HOUR=
RATE_EMAIL_PER_DAY=

# n8n (only with the n8n profile)
N8N_ENCRYPTION_KEY=
