# Copy to .env and edit. Every value is optional for a local `docker compose up`:
# Compose ships clearly marked development defaults for any variable left empty.
# Comments must stay on their own lines: an inline "# ..." after "=" would become part of the value.
# Never commit a real .env.

# General
# APP_ENV: local, test or production. Production requires every secret below (16+ characters,
# not the development defaults) and dashboard credentials.
APP_ENV=
LOG_LEVEL=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Workspaces
# ENABLED_WORKSPACES: comma-separated slugs, default northwind-academy.
ENABLED_WORKSPACES=
# ALLOW_DRAFT_WORKSPACES: true only for local experiments with draft workspaces.
ALLOW_DRAFT_WORKSPACES=

# URLs
# WEB_PUBLIC_ORIGIN: origin(s) of the web app, comma-separated, always allowed by CORS.
WEB_PUBLIC_ORIGIN=
# DASHBOARD_BASE_URL: used in owner notification links.
DASHBOARD_BASE_URL=
# PUBLIC_API_BASE_URL: agent URL as seen from the browser (default http://localhost:8000).
PUBLIC_API_BASE_URL=

# Secrets (generate each with `openssl rand -hex 24`)
# ADMIN_API_TOKEN: Next.js server to agent /admin.
ADMIN_API_TOKEN=
# N8N_API_TOKEN: n8n to agent /internal.
N8N_API_TOKEN=
# N8N_WEBHOOK_SECRET: HMAC key of the signed webhook to n8n.
N8N_WEBHOOK_SECRET=
# IP_HASH_SECRET: HMAC key used to store client IPs and emails as hashes.
IP_HASH_SECRET=

# Dashboard access (required when APP_ENV=production; HTTP Basic auth)
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Exposure
# EXPOSE_ADMIN_API: set to false to stop mounting /admin and /internal on this instance.
EXPOSE_ADMIN_API=
# TRUSTED_PROXIES: comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
TRUSTED_PROXIES=

# Orchestration
# ORCHESTRATOR: inline (default, no n8n needed) or n8n.
ORCHESTRATOR=
# COMPOSE_PROFILES: set to n8n to start the n8n service.
COMPOSE_PROFILES=

# Anti-abuse (defaults: 5 per minute, 30 per hour, 300 per hour, 3 per day)
RATE_IP_PER_MINUTE=
RATE_IP_PER_HOUR=
RATE_WORKSPACE_PER_HOUR=
RATE_EMAIL_PER_DAY=

# Email sending (approved drafts). Compose points these at Mailpit (http://127.0.0.1:8025).
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_STARTTLS: true for a real SMTP server (default false for Mailpit).
SMTP_STARTTLS=
# SMTP_SSL: true for implicit TLS (port 465). Credentials are refused without STARTTLS or SSL.
SMTP_SSL=
# SEND_MAX_ATTEMPTS: tries for transient SMTP failures (4xx, timeouts) before send_failed (default 3).
SEND_MAX_ATTEMPTS=
# SEND_STALE_MINUTES: a message stuck in "sending" this long is reported for a manual check.
SEND_STALE_MINUTES=

# n8n (only with the n8n profile)
N8N_ENCRYPTION_KEY=

# LLM provider (M2.1; the qualification graph arrives in M2.2)
# LLM_PROVIDER: fake (default, no key, no network), anthropic, bedrock or openai (skeleton only).
LLM_PROVIDER=
# LLM_MODEL_DEFAULT: model for every task (default claude-haiku-5-5).
LLM_MODEL_DEFAULT=
# LLM_MODEL_DRAFT: optional stronger model for drafting only, e.g. claude-sonnet-5-5.
LLM_MODEL_DRAFT=
# LLM_BUDGET_USD: lifetime cap (sum of all stored real-provider calls, default 5). A call is
# refused when spent plus its worst-case cost would pass the cap. Raise it deliberately.
LLM_BUDGET_USD=
# LLM_CALLS_RETENTION_DAYS: stored LLM requests/responses are purged after this long (default 30).
LLM_CALLS_RETENTION_DAYS=
# LLM_MAX_CALLS_PER_LEAD: hard cap of provider calls per agent run (default 12).
LLM_MAX_CALLS_PER_LEAD=
# AGENT_RUN_TIMEOUT_MINUTES: a run that never finished is failed after this long (default 10).
AGENT_RUN_TIMEOUT_MINUTES=
# QUALIFY_MAX_RUNS_PER_DAY: qualification runs allowed per lead per 24 hours (default 5).
QUALIFY_MAX_RUNS_PER_DAY=
ANTHROPIC_API_KEY=
# Bedrock: region of the Bedrock endpoint; AWS credentials come from the standard AWS chain.
AWS_REGION=

# Knowledge base
# EMBEDDINGS_PROVIDER: fastembed (default, local multilingual model), openai (optional) or fake (tests).
EMBEDDINGS_PROVIDER=
# EMBEDDINGS_CACHE_DIR: where the fastembed model is cached; it is downloaded on first ingest.
EMBEDDINGS_CACHE_DIR=
# KB_TOP_K / KB_MIN_SIMILARITY: retrieval defaults (5 chunks, cosine similarity >= 0.3).
KB_TOP_K=
KB_MIN_SIMILARITY=
OPENAI_API_KEY=
