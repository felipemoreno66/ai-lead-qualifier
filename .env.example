# Copy to .env and edit. Every value is optional for a local `docker compose up`:
# compose ships clearly-marked development defaults. Never commit a real .env.

# --- General ---
APP_ENV=                  # local | test | production (production requires every secret below, >= 16 chars)
LOG_LEVEL=

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Workspaces ---
ENABLED_WORKSPACES=       # comma-separated slugs; default: northwind-academy
ALLOW_DRAFT_WORKSPACES=   # true only for local experiments with draft workspaces

# --- URLs ---
WEB_PUBLIC_ORIGIN=        # origin(s) of the Next.js app, comma-separated (always allowed by CORS)
DASHBOARD_BASE_URL=       # used in owner notification links
PUBLIC_API_BASE_URL=      # FastAPI URL as seen from the browser (default http://localhost:8000)

# --- Secrets (generate with `openssl rand -hex 24`) ---
ADMIN_API_TOKEN=          # Next.js server -> FastAPI /admin
N8N_API_TOKEN=            # n8n -> FastAPI /internal
N8N_WEBHOOK_SECRET=       # FastAPI -> n8n HMAC signature
IP_HASH_SECRET=           # HMAC key used to store client IPs as hashes

# --- Orchestration ---
ORCHESTRATOR=             # inline (default, no n8n needed) | n8n
COMPOSE_PROFILES=         # set to "n8n" to start the n8n service

# --- Anti-abuse ---
RATE_IP_PER_MINUTE=       # default 5
RATE_IP_PER_HOUR=         # default 30
RATE_WORKSPACE_PER_HOUR=  # default 300
RATE_EMAIL_PER_DAY=       # default 3
TRUSTED_PROXIES=          # comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For

# --- n8n (only with the n8n profile) ---
N8N_ENCRYPTION_KEY=
