{
  "$defs": {
    "ApproveReview": {
      "properties": {
        "action": {
          "const": "approve",
          "title": "Action",
          "type": "string"
        },
        "override": {
          "default": false,
          "title": "Override",
          "type": "boolean"
        }
      },
      "required": [
        "action"
      ],
      "title": "ApproveReview",
      "type": "object"
    },
    "EditReview": {
      "description": "Edit and approve: the operator's text replaces the draft (the original is kept).",
      "properties": {
        "action": {
          "const": "edit",
          "title": "Action",
          "type": "string"
        },
        "body": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "override": {
          "default": false,
          "title": "Override",
          "type": "boolean"
        },
        "subject": {
          "anyOf": [
            {
              "maxLength": 150,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        }
      },
      "required": [
        "action",
        "body"
      ],
      "title": "EditReview",
      "type": "object"
    },
    "RegenerateReview": {
      "properties": {
        "action": {
          "const": "regenerate",
          "title": "Action",
          "type": "string"
        },
        "feedback": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback"
        }
      },
      "required": [
        "action"
      ],
      "title": "RegenerateReview",
      "type": "object"
    },
    "RejectReview": {
      "properties": {
        "action": {
          "const": "reject",
          "title": "Action",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "action"
      ],
      "title": "RejectReview",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "approve": "#/$defs/ApproveReview",
      "edit": "#/$defs/EditReview",
      "regenerate": "#/$defs/RegenerateReview",
      "reject": "#/$defs/RejectReview"
    },
    "propertyName": "action"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ApproveReview"
    },
    {
      "$ref": "#/$defs/EditReview"
    },
    {
      "$ref": "#/$defs/RejectReview"
    },
    {
      "$ref": "#/$defs/RegenerateReview"
    }
  ]
}
