# Public demo settings. `scripts/public-demo.sh init` copies this file to .env.public (gitignored)
# and fills the secrets and PUBLIC_URL. Never commit .env.public.
# Comments must stay on their own lines.

# Public HTTPS address of the demo: https://<machine>.<tailnet>.ts.net (shown by `tailscale funnel status`).
PUBLIC_URL=

# Generated by `init` (openssl rand -hex 24). Never use the "local-dev-*" development defaults.
POSTGRES_PASSWORD=
ADMIN_API_TOKEN=
N8N_API_TOKEN=
N8N_WEBHOOK_SECRET=
IP_HASH_SECRET=

# Optional
# DEMO_WEB_PORT: host port of the web app on 127.0.0.1 (the one you funnel). Default 3000.
DEMO_WEB_PORT=
# DEMO_MAILPIT_PORT: Mailpit UI on 127.0.0.1, owner only. Default 18025.
DEMO_MAILPIT_PORT=
# DEMO_RESET_AT: daily reset time, HH:MM UTC. Default 04:00.
DEMO_RESET_AT=
# DEMO_RESET_INTERVAL_HOURS: reset every N hours instead of daily at DEMO_RESET_AT.
DEMO_RESET_INTERVAL_HOURS=
# DEMO_EMBEDDINGS=fake skips the one-time embedding model download (weaker "Ask the docs" answers).
DEMO_EMBEDDINGS=
# DEMO_SUBNET: Docker subnet of the demo network if the default 172.31.250.0/24 collides.
DEMO_SUBNET=
